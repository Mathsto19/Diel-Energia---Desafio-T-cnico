# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.1.0 Project Minimal Configuration
#
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_EXAMPLE_WIFI_SSID="Wokwi-GUEST"
CONFIG_EXAMPLE_WIFI_PASSWORD=""
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=-1
CONFIG_EXAMPLE_CONNECT_IPV6=n
CONFIG_FMB_MASTER_TIMEOUT_MS_RESPOND=1000
CONFIG_MQTT_REPORT_DELETED_MESSAGES=y
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=60000
# TLS do broker publico e conexao Wi-Fi usada no Wokwi.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_CERT_VALIDATE_BUNDLE=y
CONFIG_EXAMPLE_MQTT_BROKER_URI="mqtts://test.mosquitto.org:8886"
CONFIG_EXAMPLE_SENSORS_MODBUS_TCP=n
CONFIG_FMB_COMM_MODE_TCP_EN=y
